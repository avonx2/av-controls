    "gl-matrix": "^3.4.4",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "av-controls-timeline": "./bin/serve.mjs"
